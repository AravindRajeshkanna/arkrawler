# Copy to .env and adjust as needed, then run with:
#   node --env-file=.env index.js

# Redis connection string
REDIS_URL=redis://127.0.0.1:6379

# Path to the seed URL JSON file (defaults to ./seed.json)
#SEED_FILE=./seed.json

# How many pages a single crawler.js run should crawl before exiting
# (index.js respawns it automatically)
PAGES_PER_RUN=1000

# Max concurrent HTTP connections used by the crawler
MAX_CONNECTIONS=100
